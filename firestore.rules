rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only read/write their own books.
    // There is no cross-user reading built into this prototype at all —
    // if you and friends ever want to see each other's libraries, that's
    // a deliberate later change to these rules, not an oversight here.
    match /users/{userId}/books/{isbn} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
