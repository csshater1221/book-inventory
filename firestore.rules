rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only read/write their own books.
    // There is no cross-user reading built into this prototype at all —
    // if you and friends ever want to see each other's libraries, that's
    // a deliberate later change to these rules, not an oversight here.
    match /users/{userId}/books/{isbn} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Cover photos synced across the owner's devices as base64 — kept in
    // their own collection (see coverSync.js) rather than on the book doc
    // itself, so the library view's listener on `books` never has to
    // transfer image bytes. The size guard keeps a doc well under
    // Firestore's 1 MiB limit even though images are already
    // resized/compressed client-side before they ever reach here (see
    // resizeCoverImage.js) — a defense against a client bug, not the
    // primary size control.
    match /users/{userId}/coverImages/{isbn} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.dataUrl.size() < 900000;
    }
  }
}
