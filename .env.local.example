# Copy this file to .env.local and fill in values from your Firebase
# project settings (Project settings -> General -> Your apps -> Web app).
# .env.local is gitignored — never commit real values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: only needed if you want higher Google Books quota / fewer
# "zero results" false negatives. The app works without this key.
VITE_GOOGLE_BOOKS_API_KEY=
